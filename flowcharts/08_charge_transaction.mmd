flowchart TD
    Start([访客点击充能按钮]) --> Request[前端发起充能请求]
    Request --> BeginTx[后端开启数据库事务]
    BeginTx --> CheckBalance{访客光流<br/>余额充足?}
    
    CheckBalance -->|否| Error1[返回错误: 光流不足]
    Error1 --> Rollback1[回滚事务]
    
    CheckBalance -->|是| Deduct[扣除访客光流余额<br/>-50点]
    Deduct --> UpdateTime[更新好友lastFocusTime<br/>为当前时间]
    UpdateTime --> InsertLog[插入visit_log记录<br/>action_type=1充能]
    InsertLog --> CheckSuccess{所有操作<br/>成功?}
    
    CheckSuccess -->|否| Error2[返回错误]
    Error2 --> Rollback2[回滚事务]
    
    CheckSuccess -->|是| Commit[提交事务]
    Commit --> Success[返回成功]
    Success --> Animation[前端播放量子脉冲动画]
    Animation --> Refresh[好友花园状态刷新<br/>VIBRANT生机盎然]
    
    Rollback1 --> End([结束])
    Rollback2 --> End
    Refresh --> End
    
    style Start fill:#00ff9f,stroke:#00ff9f,color:#000
    style BeginTx fill:#4ecdc4,stroke:#4ecdc4,color:#000
    style CheckBalance fill:#b026ff,stroke:#b026ff,color:#fff
    style CheckSuccess fill:#b026ff,stroke:#b026ff,color:#fff
    style Error1 fill:#ff6b6b,stroke:#ff6b6b,color:#fff
    style Error2 fill:#ff6b6b,stroke:#ff6b6b,color:#fff
    style Commit fill:#6bcf7f,stroke:#6bcf7f,color:#000
    style Animation fill:#ffd93d,stroke:#ffd93d,color:#000
    
    subgraph Transaction["数据库事务边界"]
        Deduct
        UpdateTime
        InsertLog
    end
    
    style Transaction fill:#1a1a2e,stroke:#00d4ff,stroke-width:2px,stroke-dasharray: 5 5
